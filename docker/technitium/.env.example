# Per-host settings. Copy to .env and adjust. Secrets live in secrets/*.env.

# Set to "caddy" on the host that runs the reverse proxy (network01).
# Leave empty on DNS-only hosts (network02).
COMPOSE_PROFILES=caddy

# This host's LAN IP.
HOST_IP=172.16.32.11

# Technitium's own FQDN (DNS_SERVER_DOMAIN) and the vhost Caddy proxies to its UI.
DNS_SERVER_DOMAIN=dns01.home.bintree.io
DNS_HOSTNAME=dns01.home.bintree.io

# Admin UI/API listen addresses (port 5380). Keep 127.0.0.1 for Caddy; add the LAN IP
# so the UI is reachable directly when the proxy is down. First-init only.
DNS_WEB_LISTEN=127.0.0.1,${HOST_IP}

# Zone served by the wildcard cert and the primary DNS zone.
WILDCARD_DOMAIN=home.bintree.io

# Persistent state (back up DATA_DIR; LOG_DIR is disposable).
# Use absolute paths such as /var/lib/technitium-stack if you prefer the NixOS layout.
DATA_DIR=./data
LOG_DIR=./logs

