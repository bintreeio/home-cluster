# {$VAR} / {env.VAR} come from the container environment (see compose.yml + .env).
#
# One wildcard site block + one DNS-01 wildcard cert: adding a vhost needs no new
# issuance. To add one, add a matcher/handle pair below. HTTPS upstreams are internal
# devices reached by IP whose certs never match, so encrypt without verifying and keep
# the browser's Host header so upstream redirects (TrueNAS / -> /ui/) come back to the
# vhost name rather than the upstream IP.

# all reverse proxy are in the actual Caddyfile that was added to gitignore. Below are some examples for DNS and ACME. follow the template for any future hosts.
{
	email {env.ACME_EMAIL}
	acme_dns porkbun {
		api_key {env.PORKBUN_API_KEY}
		api_secret_key {env.PORKBUN_API_SECRET_KEY}
	}
}

*.{$WILDCARD_DOMAIN} {
	# The DNS-01 propagation check must reach Porkbun's authoritative servers.
	tls {
		resolvers 1.1.1.1 9.9.9.9
	}

	# Access logs land in the /docker/appdata/caddy/logs bind mount.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	@dns host {$DNS_HOSTNAME}
	handle @dns {
		reverse_proxy 127.0.0.1:5380
	}
    @dns02 host dns02.{$WILDCARD_DOMAIN}
    handle @dns02 {
        reverse_proxy 127.0.0.1:5380
    }