# Static rendering of the Caddyfile that nix/containers/caddy.nix generates.
# {$VAR} / {env.VAR} come from the container environment (see compose.yml + .env).
#
# One wildcard site block + one DNS-01 wildcard cert: adding a vhost needs no new
# issuance. To add one, add a matcher/handle pair below. HTTPS upstreams are internal
# devices reached by IP whose certs never match, so encrypt without verifying and keep
# the browser's Host header so upstream redirects (TrueNAS / -> /ui/) come back to the
# vhost name rather than the upstream IP.
{
	email {env.ACME_EMAIL}
	acme_dns porkbun {
		api_key {env.PORKBUN_API_KEY}
		api_secret_key {env.PORKBUN_API_SECRET_KEY}
	}
}

*.{$WILDCARD_DOMAIN} {
	# The DNS-01 propagation check must reach Porkbun's authoritative servers. Never
	# use the host resolvers: technitium on this box is authoritative for the same
	# zone internally and would answer for _acme-challenge instead of Porkbun.
	tls {
		resolvers 1.1.1.1 9.9.9.9
	}

	# Access logs land in the /docker/appdata/caddy/logs bind mount.
	log {
		output file /var/log/caddy/access.log {
			roll_size 10mb
			roll_keep 5
		}
		format json
	}

	@dns host {$DNS_HOSTNAME}
	handle @dns {
		reverse_proxy 127.0.0.1:5380
	}

	@pve01 host pve01.{$WILDCARD_DOMAIN}
	handle @pve01 {
		reverse_proxy https://172.16.0.25:8006 {
			header_up Host {http.request.host}
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@pve02 host pve02.{$WILDCARD_DOMAIN}
	handle @pve02 {
		reverse_proxy https://172.16.0.26:8006 {
			header_up Host {http.request.host}
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	@pve03 host pve03.{$WILDCARD_DOMAIN}
	handle @pve03 {
		reverse_proxy https://172.16.0.27:8006 {
			header_up Host {http.request.host}
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	# Unmatched names under the wildcard are refused.
	handle {
		abort
	}
}
